# Copy to .env and fill in values
ANTHROPIC_API_KEY=sk-ant-...

# Email notifications (Gmail SMTP)
GMAIL_USER=tuanbin007@gmail.com
GMAIL_APP_PASSWORD=          # 16-char app password from Google Account → Security → App passwords
NOTIFY_EMAIL=tuanbin007@gmail.com

# Telegram notifications (get token from @BotFather, chat_id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional data source tokens
VNSTOCK_TOKEN=
SSI_CLIENT_ID=
SSI_CLIENT_SECRET=

# Dashboard settings (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME_BASE=dark
